{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Authority Delta authenticated read-only review and decision previews. No authority write or policy publication.",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "CodeVersion": {
      "Type": "String"
    },
    "DataKey": {
      "Type": "String"
    },
    "DataVersion": {
      "Type": "String"
    },
    "UiDigest": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{64}$"
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-origin"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "ResponseHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://*.execute-api.ap-northeast-1.amazonaws.com https://*.auth.ap-northeast-1.amazoncognito.com; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
              "Override": true
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "SOLIFAN Authority Delta review workspace",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_200",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginPath": {
                "Fn::Sub": "/ui/${UiDigest}"
              },
              "OriginAccessControlId": {
                "Fn::GetAtt": [
                  "OriginAccess",
                  "Id"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "MinTTL": 0,
            "DefaultTTL": 0,
            "MaxTTL": 86400,
            "ResponseHeadersPolicyId": {
              "Ref": "ResponseHeaders"
            }
          }
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/ui/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "ReviewerPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": "authority-delta-reviewers",
        "UserPoolTier": "LITE",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "UsernameConfiguration": {
          "CaseSensitive": true
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false,
            "TemporaryPasswordValidityDays": 7
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ReviewResource": {
      "Type": "AWS::Cognito::UserPoolResourceServer",
      "Properties": {
        "UserPoolId": {
          "Ref": "ReviewerPool"
        },
        "Identifier": "authority-delta",
        "Name": "Authority Delta review",
        "Scopes": [
          {
            "ScopeName": "read",
            "ScopeDescription": "Read assigned release evidence"
          }
        ]
      }
    },
    "ReviewerClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "ReviewerPool"
        },
        "ClientName": "authority-delta-browser",
        "GenerateSecret": false,
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "authority-delta/read"
        ],
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 15,
        "IdTokenValidity": 15,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes"
        },
        "ExplicitAuthFlows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ]
      },
      "DependsOn": "ReviewResource"
    },
    "ReviewerDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "ReviewerPool"
        },
        "Domain": {
          "Fn::Sub": "authority-delta-${AWS::AccountId}-review"
        },
        "ManagedLoginVersion": 1
      }
    },
    "Reviewer": {
      "Type": "AWS::Cognito::UserPoolUser",
      "Properties": {
        "UserPoolId": {
          "Ref": "ReviewerPool"
        },
        "Username": "okada",
        "MessageAction": "SUPPRESS"
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/authority-delta-review",
        "RetentionInDays": 14
      }
    },
    "ReviewRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "authority-delta-review-reader",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadPinnedReviewOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${DataKey}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:VersionId": {
                        "Ref": "DataVersion"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ReviewFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "authority-delta-review",
        "Runtime": "python3.12",
        "Handler": "handler.handler",
        "Role": {
          "Fn::GetAtt": [
            "ReviewRole",
            "Arn"
          ]
        },
        "Timeout": 15,
        "MemorySize": 128,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Ref": "CodeVersion"
          }
        },
        "Environment": {
          "Variables": {
            "CLIENT_ID": {
              "Ref": "ReviewerClient"
            },
            "REVIEWER_USERNAME": "okada",
            "DATA_BUCKET": {
              "Ref": "ArtifactBucket"
            },
            "DATA_KEY": {
              "Ref": "DataKey"
            },
            "DATA_VERSION": {
              "Ref": "DataVersion"
            }
          }
        }
      }
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "authority-delta-review",
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          ],
          "AllowMethods": [
            "GET",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization"
          ],
          "ExposeHeaders": [
            "x-request-id"
          ],
          "MaxAge": 300
        }
      }
    },
    "Authorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "AuthorizerType": "JWT",
        "Name": "reviewer-jwt",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Audience": [
            {
              "Ref": "ReviewerClient"
            }
          ],
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${ReviewerPool}"
          }
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ReviewFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 20000
      }
    },
    "ReviewRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "GET /review",
        "Target": {
          "Fn::Sub": "integrations/${Integration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "Authorizer"
        },
        "AuthorizationScopes": [
          "authority-delta/read"
        ]
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        }
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ReviewFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/GET/review"
        }
      }
    }
  },
  "Outputs": {
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "WorkspaceUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}/"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Api",
          "ApiEndpoint"
        ]
      }
    },
    "ApiId": {
      "Value": {
        "Ref": "Api"
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "ReviewerPool"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "ReviewerClient"
      }
    },
    "AuthOrigin": {
      "Value": {
        "Fn::Sub": "https://${ReviewerDomain}.auth.${AWS::Region}.amazoncognito.com"
      }
    },
    "ReviewerUsername": {
      "Value": "okada"
    },
    "ReviewFunction": {
      "Value": {
        "Ref": "ReviewFunction"
      }
    }
  }
}
